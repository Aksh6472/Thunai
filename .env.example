# Thunai — example environment. Copy to `.env` and fill in. NEVER commit `.env`.
# Placeholders starting with "change-me" are rejected at startup when THUNAI_ENV=production.
# Full reference: ENVIRONMENT.md

# ---------- App ----------
THUNAI_API_PORT=8000                       # host port for uvicorn (make dev / make demo); change if 8000 is taken
THUNAI_ENV=development                     # development | test | production
THUNAI_DEMO_MODE=true                      # enables /demo/*, SimClock, SIMULATED chips. Refused when THUNAI_ENV=production
THUNAI_LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
THUNAI_PUBLIC_WEB_URL=http://localhost:5173   # base for trusted-contact links; use LAN IP or tunnel URL so a phone can open it
THUNAI_CORS_ORIGINS=http://localhost:5173     # comma-separated

# ---------- Database ----------
THUNAI_DB_PORT=5432                        # host port for docker-compose Postgres; change if 5432 is taken
POSTGRES_USER=thunai
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=thunai
DATABASE_URL=postgresql+psycopg://thunai:change-me-local-db-password@localhost:5432/thunai
TEST_DATABASE_URL=postgresql+psycopg://thunai:change-me-local-db-password@localhost:5432/thunai_test

# ---------- Security (generate real values; see ENVIRONMENT.md §3) ----------
THUNAI_JWT_SECRET=change-me-openssl-rand-hex-32
THUNAI_JWT_TTL_MINUTES=60
THUNAI_SERVICE_API_KEY=change-me-openssl-rand-hex-24
THUNAI_PII_ENCRYPTION_KEY=change-me-fernet-key
THUNAI_HMAC_KEY=change-me-openssl-rand-hex-32
THUNAI_SEED_PASSWORD=change-me-demo-password   # password for all seeded demo users
THUNAI_CONTACT_TOKEN_TTL_MINUTES=30

# ---------- Risk engine ----------
THUNAI_SCORING_CONFIG_PATH=config/scoring_v1.yaml   # relative to backend/
THUNAI_COOLING_OFF_MINUTES=240
THUNAI_TRUSTED_CONTACT_ACTIVATION_HOURS=72
THUNAI_FRI_TIMEOUT_MS=300

# ---------- Notifications ----------
THUNAI_NOTIFIER=console                    # console | twilio | telegram  (console is always the fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TELEGRAM_BOT_TOKEN=
# Demo-only: real phone/chat of the teammate playing the trusted contact (local .env only)
THUNAI_DEMO_CONTACT_PHONE_E164=
THUNAI_DEMO_CONTACT_TELEGRAM_CHAT_ID=

# ---------- LLM (optional, FR-21) ----------
THUNAI_LLM_ENABLED=false
ANTHROPIC_API_KEY=
THUNAI_LLM_MODEL=claude-opus-5-5
THUNAI_LLM_TIMEOUT_SECONDS=10

# ---------- Simulator ----------
THUNAI_API_BASE_URL=http://localhost:8000/api/v1
THUNAI_SIM_DEFAULT_SPEED=4320              # simulated seconds per real second (3 days ≈ 60 s)

# ---------- Frontend (Vite reads frontend/.env; only VITE_* are exposed to the browser) ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEMO_MODE=true
