# Kaaval AI — example environment. Copy to `.env` and fill in. NEVER commit `.env`.
# Placeholders starting with "change-me" are rejected at startup when KAAVAL_ENV=production.
# Full reference: ENVIRONMENT.md

# ---------- App ----------
KAAVAL_API_PORT=8000                       # host port for uvicorn (make dev / make demo); change if 8000 is taken
KAAVAL_ENV=development                     # development | test | production
KAAVAL_DEMO_MODE=true                      # enables /demo/*, SimClock, SIMULATED chips. Refused when KAAVAL_ENV=production
KAAVAL_LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
KAAVAL_PUBLIC_WEB_URL=http://localhost:5173   # base for trusted-contact links; use LAN IP or tunnel URL so a phone can open it
KAAVAL_CORS_ORIGINS=http://localhost:5173     # comma-separated

# ---------- Database ----------
KAAVAL_DB_PORT=5432                        # host port for docker-compose Postgres; change if 5432 is taken
POSTGRES_USER=kaaval
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=kaaval
DATABASE_URL=postgresql+psycopg://kaaval:change-me-local-db-password@localhost:5432/kaaval
TEST_DATABASE_URL=postgresql+psycopg://kaaval:change-me-local-db-password@localhost:5432/kaaval_test

# ---------- Security (generate real values; see ENVIRONMENT.md §3) ----------
KAAVAL_JWT_SECRET=change-me-openssl-rand-hex-32
KAAVAL_JWT_TTL_MINUTES=60
KAAVAL_SERVICE_API_KEY=change-me-openssl-rand-hex-24
KAAVAL_PII_ENCRYPTION_KEY=change-me-fernet-key
KAAVAL_HMAC_KEY=change-me-openssl-rand-hex-32
KAAVAL_SEED_PASSWORD=change-me-demo-password   # password for all seeded demo users
KAAVAL_CONTACT_TOKEN_TTL_MINUTES=30

# ---------- Risk engine ----------
KAAVAL_SCORING_CONFIG_PATH=config/scoring_v1.yaml   # relative to backend/
KAAVAL_COOLING_OFF_MINUTES=240
KAAVAL_TRUSTED_CONTACT_ACTIVATION_HOURS=72
KAAVAL_FRI_TIMEOUT_MS=300

# ---------- Notifications ----------
KAAVAL_NOTIFIER=console                    # console | twilio | telegram  (console is always the fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TELEGRAM_BOT_TOKEN=
# Demo-only: real phone/chat of the teammate playing the trusted contact (local .env only)
KAAVAL_DEMO_CONTACT_PHONE_E164=
KAAVAL_DEMO_CONTACT_TELEGRAM_CHAT_ID=

# ---------- LLM (optional, FR-21) ----------
KAAVAL_LLM_ENABLED=false
ANTHROPIC_API_KEY=
KAAVAL_LLM_MODEL=claude-opus-5-5
KAAVAL_LLM_TIMEOUT_SECONDS=10

# ---------- Simulator ----------
KAAVAL_API_BASE_URL=http://localhost:8000/api/v1
KAAVAL_SIM_DEFAULT_SPEED=4320              # simulated seconds per real second (3 days ≈ 60 s)

# ---------- Frontend (Vite reads frontend/.env; only VITE_* are exposed to the browser) ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEMO_MODE=true
